.page--edit {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

/* ---------- 执行图 ---------- */
.flow {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.flow__arrow {
  text-align: center;
  color: #cbd5e1;
  font-size: 26rpx;
  line-height: 1;
  padding: 4rpx 0;
}
.node {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 2rpx solid var(--line);
  background: #fff;
}
.node--source {
  border-color: #c7d2fe;
  background: #f5f7ff;
}
.node--filter {
  border-color: #fde68a;
  background: #fffdf5;
}
.node--target {
  border-color: #a7f3d0;
  background: #f4fdf9;
}
.node--running {
  animation: pulse 1.1s ease-in-out infinite;
}
@keyframes pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.28);
  }
  50% {
    box-shadow: 0 0 0 8rpx rgba(79, 70, 229, 0);
  }
}
.node__tag {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  flex-shrink: 0;
}
.node__tag--source {
  background: #4f46e5;
}
.node__tag--filter {
  background: #f59e0b;
}
.node__tag--target {
  background: #10b981;
}
.node__primary {
  font-size: 26rpx;
  color: var(--t1);
  font-weight: 500;
}
.node__secondary {
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 2rpx;
}
.targets {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* ---------- 运行结果 ---------- */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.stats-grid__item {
  flex: 1 1 calc(50% - 16rpx);
  box-sizing: border-box;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}
.stats-grid__value {
  font-size: 32rpx;
  font-weight: 700;
}
.stats-grid__label {
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 4rpx;
}

/* ---------- 危险区 ---------- */
.danger-zone {
  padding-top: 8rpx;
}

/* ---------- 底部操作条 ---------- */
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid var(--line);
  padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
  z-index: 20;
}
.actionbar__inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.actionbar__inner .grow {
  flex: 1;
}
