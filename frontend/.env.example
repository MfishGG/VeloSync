# 前端环境变量（复制为 frontend/.env 后重启 dev server 生效）
# 注意：Vite 只暴露 VITE_ 前缀的变量给浏览器端

# ---- 高德地图（可选，用于 FIT 轨迹回放与路网底图）----
# 申请：https://console.amap.com/dev/key/app  → 添加 Key → 服务平台选「Web端(JS API)」
# 未配置时 FIT 页面自动降级为内置 SVG 轨迹简图
VITE_AMAP_KEY=df3d3b66382c5da25f81d3dacefe5c63
# JS API 2.0 必须同时配置安全密钥（与 Key 同一页面获取）
VITE_AMAP_SECURITY_CODE=c5f90154bb47468ad9c3da2a5ea62bb0

# ---- 后端地址（默认走 Vite 代理 /api → 127.0.0.1:8000，通常无需修改）----
# VITE_API_BASE=http://127.0.0.1:8000/api
