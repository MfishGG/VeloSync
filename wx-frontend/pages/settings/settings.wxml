<view class="page">
  <view class="head">
    <view class="head__title">设置</view>
    <view class="head__sub">账号 · 缓存 · 关于</view>
  </view>

  <!--
    「后端接口地址」与「开发者资源」两块已整体移除（任何版本都不再渲染）。
    前者是 Token 外泄通道，后者把 Django Admin / OpenAPI 路径摆在终端用户面前；
    二者都只是联调期的便利设计，不该出现在面向用户的小程序里。
    需要切换后端地址时改 config.js；开发版仍可在登录页改（那是唯一保留的调试入口）。
  -->

  <!-- 账号 -->
  <view class="card">
    <view class="card__title">当前账号</view>
    <view class="t-md t1" style="margin-top:14rpx">{{user.nickname || user.username || '-'}}</view>
    <view class="t-xs t3" style="margin-top:6rpx">@{{user.username}} · ID {{user.id}}</view>
  </view>

  <!-- 其它 -->
  <view class="card">
    <view class="switch-row" bindtap="onClearCache">
      <view class="switch-row__text">
        <view class="t-md t1">清除本地缓存</view>
        <view class="t-xs t3">清除登录态与本地数据</view>
      </view>
      <view class="menu__arrow">›</view>
    </view>
    <view class="divider"></view>
    <view class="switch-row" bindtap="onAbout">
      <view class="switch-row__text">
        <view class="t-md t1">关于 VeloSync 速同</view>
        <view class="t-xs t3">版本 v{{version}}</view>
      </view>
      <view class="menu__arrow">›</view>
    </view>
    <view class="divider"></view>
    <view class="t-xs t3">运行环境：{{envInfo}}</view>
  </view>

  <view class="safe-bottom"></view>
</view>
