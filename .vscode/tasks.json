{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "小程序：API 契约冒烟测试",
      "type": "shell",
      "command": "node tools/api-smoke.js",
      "options": { "cwd": "${workspaceFolder}/wx-frontend" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "小程序：图表绘制测试",
      "type": "shell",
      "command": "node tools/chart-test.js",
      "options": { "cwd": "${workspaceFolder}/wx-frontend" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "小程序：全量静态校验（JS 语法 / JSON / 四件套 / 图标）",
      "type": "shell",
      "command": "node tools/check.js",
      "options": { "cwd": "${workspaceFolder}/wx-frontend" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "小程序：生成静态预览页",
      "type": "shell",
      "command": "node tools/make_preview.js",
      "options": { "cwd": "${workspaceFolder}/wx-frontend" },
      "problemMatcher": []
    },
    {
      "label": "后端：启动开发服务器 (127.0.0.1:8000)",
      "type": "shell",
      "command": "./.venv/Scripts/python.exe manage.py runserver 127.0.0.1:8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Web 前端：启动开发服务器 (5173)",
      "type": "shell",
      "command": "yarn dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Web 前端：类型检查 + 构建",
      "type": "shell",
      "command": "yarn build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
