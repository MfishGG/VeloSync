.login {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  background: linear-gradient(180deg, #4f46e5 0%, #6366f1 220rpx, #f1f5f9 480rpx, #f1f5f9 100%);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0 10rpx;
}
.hero__logo {
  width: 152rpx;
  height: 152rpx;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.22);
}
.hero__name {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
.hero__sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.card.stack > .field + .field {
  margin-top: 4rpx;
}

.tip {
  font-size: 22rpx;
  color: var(--t3);
  text-align: center;
}

/* 底部常驻的接口地址入口（真机预览时随时可改） */
.login__base {
  text-align: center;
  font-size: 22rpx;
  color: var(--t3);
  padding: 4rpx 0;
}

/* 分隔行 */
.divider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.divider-row__line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}
.divider-row__text {
  font-size: 22rpx;
  color: var(--t3);
}

/* 微信按钮 */
.btn--wx {
  background: #07c160;
  color: #fff;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.wx-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  margin-right: 4rpx;
}
.wx-note {
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--t3);
  text-align: center;
  padding: 0 12rpx;
}
