<view class="page">
  <view class="head">
    <view class="head__title">账号管理</view>
    <view class="head__sub">绑定平台账号 · Token 加密存储 · 支持同平台多账号</view>
  </view>

  <view class="alert alert--danger" wx:if="{{error}}">
    <view>{{error}}</view>
    <view class="btn btn--ghost btn--sm alert__action" bindtap="reload">重新加载</view>
  </view>
  <view class="loading" wx:if="{{loading}}"><view class="spinner"></view></view>

  <block wx:if="{{!loading}}">
    <!-- 可绑定平台 -->
    <!-- 这里是终端用户界面：「三级兜底」那套开发者口径只留在后台 admin 与 README -->
    <view class="card">
      <view class="card__title">可绑定的平台</view>
      <view class="card__hint">
        选择平台完成授权，之后即可自动同步该平台的运动记录
      </view>

      <!-- 列表为空时给个说明，不要留一片空白：用户会以为页面坏了 -->
      <view class="empty" wx:if="{{platforms.length === 0}}">
        <view class="empty__icon">📡</view>暂无可绑定的平台
      </view>

      <view class="pcard" wx:for="{{platforms}}" wx:key="id">
        <view class="row-between">
          <view class="row-gap grow">
            <view class="pcard__logo">{{item.name[0]}}</view>
            <view class="grow">
              <view class="t-md bold t1 ellipsis">{{item.name}}</view>
              <view class="t-xs t3">
                {{item.channelLabel}} · {{item.upload ? '可上传' : '仅拉取'}}
              </view>
            </view>
          </view>
          <view class="chip {{item.boundCount ? 'chip--success' : ''}}">
            {{item.boundCount ? '已绑定 ' + item.boundCount : '未绑定'}}
          </view>
        </view>

        <view class="pcard__hint" style="margin-top:14rpx">{{item.bindHint}}</view>

        <view class="pcard__hint" wx:if="{{!item.oauth_ready && item.oauth_missing.length}}">
          该平台暂未开放正式授权，可以先用演示身份体验完整流程
        </view>

        <view
          class="btn btn--soft btn--block"
          style="margin-top:16rpx"
          data-code="{{item.code}}"
          bindtap="onBind"
        >
          {{item.boundCount ? '再绑一个 / 重新授权' : '绑定账号'}}
        </view>
      </view>
    </view>

    <!-- 已绑定 -->
    <view class="card">
      <view class="row-between">
        <view class="card__title">已绑定账号</view>
        <text class="t-xs t3">{{accounts.length}} 个</text>
      </view>

      <view class="empty" wx:if="{{accounts.length === 0}}">
        <view class="empty__icon">🔗</view>还没有绑定任何账号
      </view>

      <view class="acc" wx:for="{{accounts}}" wx:key="id">
        <view class="grow">
          <view class="row-gap">
            <view class="t-md bold t1 ellipsis">{{item.displayName}}</view>
            <view class="badge" wx:if="{{item.isDemo}}" style="background:#f5f3ff;color:#7c3aed">
              演示身份
            </view>
          </view>
          <view class="t-xs t3" style="margin-top:6rpx">
            {{item.platformName}} · {{item.platformUserId}}
          </view>
          <view class="t-xs t3">绑定于 {{item.created}} · 状态 {{item.statusLabel}}</view>
        </view>
        <view
          class="btn btn--danger-soft btn--sm"
          data-id="{{item.id}}"
          data-name="{{item.displayName}}"
          bindtap="onUnbind"
        >
          解绑
        </view>
      </view>
    </view>
  </block>

  <view class="safe-bottom"></view>

  <!-- 账号密码绑定（佳明这类没有开放 OAuth 的平台） -->
  <view class="sheet-mask" wx:if="{{bindSheet}}" bindtap="closeBindSheet"></view>
  <view class="sheet" wx:if="{{bindSheet}}">
    <view class="sheet__title">{{bindSheet.name}}</view>
    <view class="sheet__hint">{{bindSheet.hint}}</view>

    <block wx:if="{{bindSheet.step === 'password'}}">
      <view class="field">
        <view class="field__label">账号</view>
        <input
          class="field__input"
          value="{{bindSheet.username}}"
          data-field="username"
          bindinput="onBindInput"
          placeholder="邮箱或手机号"
          placeholder-class="field__ph"
        />
      </view>
      <view class="field">
        <view class="field__label">密码</view>
        <input
          class="field__input"
          password
          value="{{bindSheet.password}}"
          data-field="password"
          bindinput="onBindInput"
          placeholder="仅用于登录，不会保存"
          placeholder-class="field__ph"
        />
      </view>
    </block>

    <block wx:else>
      <view class="field">
        <view class="field__label">验证码</view>
        <input
          class="field__input"
          type="number"
          value="{{bindSheet.verifyCode}}"
          data-field="verifyCode"
          bindinput="onBindInput"
          placeholder="短信或邮件里收到的验证码"
          placeholder-class="field__ph"
        />
      </view>
    </block>

    <view class="alert alert--danger sheet__error" wx:if="{{bindSheet.error}}">
      {{bindSheet.error}}
    </view>

    <view class="sheet__actions">
      <view class="btn btn--ghost" bindtap="closeBindSheet">取消</view>
      <view
        class="btn btn--primary grow"
        wx:if="{{bindSheet.step === 'password'}}"
        bindtap="submitPassword"
      >
        {{bindSheet.busy ? '登录中…' : '登录并绑定'}}
      </view>
      <view class="btn btn--primary grow" wx:else bindtap="submitMfa">
        {{bindSheet.busy ? '验证中…' : '提交验证码'}}
      </view>
    </view>
  </view>
</view>
