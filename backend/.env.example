# ===== VeloSync 后端环境变量示例（复制为 .env 后按需修改）=====

DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# 数据库：默认本地 MySQL 8（localhost:3306 / 库 velosync）；改成 sqlite 则用 backend/db.sqlite3
DB_ENGINE=mysql
DB_NAME=velosync
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Celery：生产应为 0 并启动 worker/beat（否则 auto_run 定时任务不会触发）。
# 注意 0 也**不会**让请求阻塞：没有 Redis / 没起 worker 时，
# dispatch_run() 会自动回退到后台线程执行。
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=0
# 单次运行的硬上限（秒）与僵尸运行判定阈值（分钟）
CELERY_TASK_TIME_LIMIT=1800
PIPELINE_RUN_TIMEOUT_MINUTES=30

# 共享缓存（限流额度、微信 access_token、OAuth state 一次性校验依赖它）。
# 留空用进程内缓存：多 worker 时限流额度会被放大成 N 倍。
# Django 5.1 用内置 RedisCache，需 redis 包（requirements 已含）。
CACHE_URL=

# CORS 与前端地址（OAuth 回调重定向用）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF 信任来源：通过 Vite(5173) 代理访问 Django Admin 时必须登记，否则登录 POST 会 403
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# 平台 OAuth 回调的固定基址（各平台要求 redirect_uri 逐字匹配）。
# 留空则用 request.build_absolute_uri()，配合 SECURE_PROXY_SSL_HEADER 可正确得到 https。
PLATFORM_REDIRECT_BASE_URL=

# 平台 Token 加密密钥（Fernet key，留空则由 SECRET_KEY 派生；生产必须显式设置）。
# 同时用于加密 Platform.client_secret。
TOKEN_ENCRYPTION_KEY=

# /api/health/ 的详细诊断信息默认不外泄；带上 X-Health-Token 才返回。
# 留空 = 仅 DEBUG 模式可见。
HEALTH_DETAIL_TOKEN=

# 限流额度（可选覆盖）
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PHONE=10/hour

# 第三方快捷登录（微信 / QQ / 微博）
# 留空 = 演示（mock）模式：前端仍可一键体验登录注册；填入凭证后自动切换为真实 OAuth2
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_SECRET=
WEIBO_APP_ID=
WEIBO_APP_SECRET=
# 真实 OAuth 回调的后端基址（须与开放平台登记的回调域名一致）
SOCIAL_REDIRECT_BASE_URL=http://127.0.0.1:8000

# 微信小程序（wx-frontend）登录：小程序后台 → 开发管理 → 开发设置 里的 AppID / AppSecret
# 留空则小程序端自动使用「演示身份」登录
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
