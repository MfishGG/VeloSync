.page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 步骤条 */
.steps {
  display: flex;
  gap: 8rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 20rpx 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}
.step__dot {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #94a3b8;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.step--on .step__dot {
  background: var(--primary);
  color: #fff;
}
.step__label {
  font-size: 20rpx;
  color: #94a3b8;
  text-align: center;
}
.step--on .step__label {
  color: var(--primary);
  font-weight: 500;
}

/* 操作条 */
.wizard-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.wizard-actions .grow {
  flex: 1;
}
