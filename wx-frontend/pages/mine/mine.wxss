/* ---------------- 身份栏：一条白色细栏，整条可点 ---------------- */
.ident {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}
.ident:active {
  background: #fafbfd;
}

.ident__avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.ident__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: block;
}
.ident__avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-soft);
}
.ident__avatar-logo {
  width: 60rpx;
  height: 60rpx;
}
/* 微信连接状态点 */
.ident__dot {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #07c160;
  border: 4rpx solid #fff;
}

.ident__meta {
  flex: 1;
  min-width: 0;
}
.ident__name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--t1);
  line-height: 1.3;
}
.ident__sub {
  font-size: 23rpx;
  color: var(--t3);
  margin-top: 6rpx;
}
.ident__arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
  transition: transform 0.2s ease;
}
.ident__arrow--up {
  transform: rotate(90deg);
}

/* ---------------- 个人资料（头像 / 昵称 / 手机号） ---------------- */
.profile {
  background: #fff;
  border-radius: 28rpx;
  margin-top: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}
.profile__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.profile__row:last-of-type {
  border-bottom: none;
}
/* button 重置：微信默认按钮有边框、圆角与最小宽度，会破坏行布局 */
.profile__row--btn {
  width: 100%;
  margin: 0;
  background: transparent;
  border-radius: 0;
  text-align: left;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}
.profile__row--btn::after {
  border: none;
}
.profile__row--btn:active,
.profile__row:active {
  background: #f8fafc;
}
.profile__label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 27rpx;
  color: var(--t2);
}
.profile__value {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.profile__avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: block;
}
.profile__avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-soft);
}
.profile__avatar-logo {
  width: 46rpx;
  height: 46rpx;
}
.profile__input {
  min-width: 0;
  text-align: right;
  font-size: 27rpx;
  color: var(--t1);
}
.profile__phone {
  font-size: 27rpx;
  color: var(--t1);
  font-family: Consolas, Menlo, monospace;
}
.profile__ph,
.profile__ph-text {
  font-size: 27rpx;
  color: var(--t3);
}
.profile__hint {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--t3);
}
/* 绑定手机号：做成小胶囊链接，与 ids__copy 同一视觉语言 */
.profile__link {
  flex-shrink: 0;
  margin: 0;
  padding: 4rpx 20rpx;
  min-width: 0;
  line-height: 1.6;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
}
.profile__link::after {
  border: none;
}
.profile__arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
}
.profile__tip {
  font-size: 20rpx;
  color: var(--t3);
  padding: 14rpx 26rpx 18rpx;
  text-align: center;
}

/* ---------------- 账号信息（展开区） ---------------- */
.ids {
  background: #fff;
  border-radius: 24rpx;
  margin-top: 16rpx;
  padding: 4rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  animation: idsIn 0.2s ease;
}
@keyframes idsIn {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.ids__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line-soft);
}
.ids__row:last-of-type {
  border-bottom: none;
}
.ids__row:active {
  opacity: 0.6;
}
.ids__label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 23rpx;
  color: var(--t3);
}
.ids__value {
  flex: 1;
  min-width: 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 22rpx;
  color: var(--t1);
}
.ids__copy {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.ids__tip {
  font-size: 20rpx;
  color: var(--t3);
  padding: 14rpx 0 18rpx;
  text-align: center;
}

/* ---------------- 概览 ---------------- */
.mini-stats {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.mini-stat {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}
.mini-stat:active {
  background: #fafbfd;
}
.mini-stat__value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--t1);
  line-height: 1.2;
}
.mini-stat__label {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 8rpx;
}

/* ---------------- 功能列表 ---------------- */
.menu {
  background: #fff;
  border-radius: 28rpx;
  margin-top: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}
.menu__caption {
  font-size: 22rpx;
  color: var(--t3);
  padding: 24rpx 26rpx 8rpx;
}
.menu__item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.menu__item:last-child {
  border-bottom: none;
}
.menu__item:active {
  background: #f8fafc;
}
/* 左侧色条代替图标，省空间 */
.menu__bar {
  width: 8rpx;
  height: 40rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.menu__bar--primary {
  background: var(--primary);
}
.menu__bar--warning {
  background: var(--warning);
}
.menu__bar--muted {
  background: #cbd5e1;
}
.menu__title {
  font-size: 29rpx;
  color: var(--t1);
  font-weight: 500;
}
.menu__extra {
  font-size: 22rpx;
  color: var(--t3);
}
.menu__arrow {
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
}
