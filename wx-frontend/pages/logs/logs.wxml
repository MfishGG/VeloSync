<view class="page">
  <view class="head">
    <view class="head__title">同步日志</view>
    <view class="head__sub">共 {{count}} 条 · 按级别与同步任务筛选</view>
  </view>

  <!-- 筛选 -->
  <view class="filters">
    <view class="segment">
      <view
        class="segment__item {{level === item.value ? 'segment__item--active' : ''}}"
        wx:for="{{levels}}"
        wx:key="label"
        data-value="{{item.value}}"
        bindtap="onLevelTap"
      >
        {{item.label}}
      </view>
    </view>

    <picker
      mode="selector"
      range="{{pipelineLabels}}"
      value="{{pipelineIndex}}"
      bindchange="onPipelineChange"
    >
      <view class="picker-box" style="margin-top:16rpx">
        <text class="t1">{{pipelineLabels[pipelineIndex]}}</text>
        <text class="t3">▾</text>
      </view>
    </picker>
  </view>

  <view class="alert alert--danger" wx:if="{{error}}">{{error}}</view>
  <view class="loading" wx:if="{{loading}}"><view class="spinner"></view></view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <view class="empty__icon">📜</view>没有符合条件的日志
  </view>

  <!-- 列表 -->
  <view class="card" wx:if="{{list.length}}">
    <view
      class="log"
      wx:for="{{list}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="onItemTap"
    >
      <view class="log__dot" style="background:{{item.color}}"></view>
      <view class="grow">
        <view class="log__head">
          <view class="badge" style="color:{{item.color}};background:{{item.bg}}">{{item.levelLabel}}</view>
          <text class="t-xs t3">{{item.time}}</text>
        </view>
        <view class="log__msg">{{item.message}}</view>
        <view class="log__meta">
          <text>{{item.pipeline}}</text>
          <text wx:if="{{item.activity}}"> · {{item.activity}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loadingMore}}"><view class="spinner"></view></view>
  <view class="t-xs t3" wx:if="{{!hasMore && list.length}}" style="text-align:center;padding:20rpx 0">
    已经到底了
  </view>

  <view class="safe-bottom"></view>
</view>
