.head {
  padding: 8rpx 8rpx 24rpx;
}
.head__title {
  font-size: 38rpx;
  font-weight: 700;
}
.head__sub {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* 图例 */
.legend-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.legend-bar__item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 矩阵 */
.matrix-scroll {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
  margin-top: 20rpx;
}
.matrix {
  display: inline-block;
  min-width: 100%;
}
.mrow {
  display: flex;
  align-items: stretch;
  border-bottom: 2rpx solid var(--line-soft);
}
.mrow:last-child {
  border-bottom: none;
}
.mrow--head {
  background: #f8fafc;
  border-bottom: 2rpx solid var(--line);
}
.mcell {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  box-sizing: border-box;
}
.mcell--name {
  width: 280rpx;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  border-right: 2rpx solid var(--line-soft);
}
.mcell--plat {
  width: 150rpx;
  justify-content: center;
  border-right: 2rpx solid var(--line-soft);
}
.mcell--plat:last-child {
  border-right: none;
}
.plat-name {
  font-size: 20rpx;
  color: var(--t2);
  max-width: 130rpx;
  text-align: center;
}

/* 状态格 */
.cell {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}
.cell:active {
  opacity: 0.7;
}
.cell--mini {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}
