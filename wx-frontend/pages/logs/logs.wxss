.head {
  padding: 8rpx 8rpx 24rpx;
}
.head__title {
  font-size: 38rpx;
  font-weight: 700;
}
.head__sub {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.filters {
  background: #fff;
  border-radius: 22rpx;
  padding: 18rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.filters .segment__item {
  font-size: 22rpx;
  padding: 12rpx 0;
}

/* 日志项 */
.log {
  display: flex;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line-soft);
}
.log:last-child {
  border-bottom: none;
}
.log:active {
  background: #fbfcfe;
}
.log__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}
.log__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.log__msg {
  font-size: 26rpx;
  color: var(--t1);
  margin-top: 8rpx;
  line-height: 1.55;
  word-break: break-all;
}
.log__meta {
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 6rpx;
}
