.hello {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 8rpx 28rpx;
}
.hello__hi {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--t1);
}
.hello__sub {
  font-size: 24rpx;
  color: var(--t3);
  margin-top: 4rpx;
}

/* 统计卡 */
.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.stat {
  flex: 1 1 calc(50% - 20rpx);
  box-sizing: border-box;
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
  border-left: 8rpx solid var(--primary);
}
.stat--primary {
  border-left-color: #4f46e5;
}
.stat--success {
  border-left-color: #10b981;
}
.stat--warning {
  border-left-color: #f59e0b;
}
.stat__value {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--t1);
  line-height: 1.1;
}
.stat__unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--t3);
  margin-left: 6rpx;
}
.stat__label {
  font-size: 24rpx;
  color: var(--t3);
  margin-top: 8rpx;
}

/* 图表 */
.chart {
  width: 100%;
  display: block;
}
.chart--pie {
  height: 340rpx;
  margin-top: 16rpx;
}
.chart--trend {
  height: 320rpx;
  margin-top: 16rpx;
}

/* 图例 */
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  margin-top: 12rpx;
}
.legend__item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
}
.legend__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.legend__name {
  font-size: 22rpx;
  color: var(--t2);
  max-width: 220rpx;
}
.legend__val {
  font-size: 22rpx;
  color: var(--t3);
}

/* 最近同步 */
.recent {
  margin-top: 8rpx;
}
.recent__item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line-soft);
}
.recent__item:last-child {
  border-bottom: none;
}
.recent__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--success);
  flex-shrink: 0;
}
.recent__name {
  font-size: 26rpx;
  color: var(--t1);
}
.recent__meta {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 2rpx;
}

/* 快捷入口 */
.quick {
  display: flex;
  gap: 20rpx;
}
.quick__item {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.quick__item:active {
  background: #f8fafc;
}
.quick__icon {
  font-size: 38rpx;
  color: var(--primary);
  line-height: 1;
}
.quick__label {
  font-size: 24rpx;
  color: var(--t2);
  margin-top: 10rpx;
}
