.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  border-radius: 26rpx;
  padding: 34rpx 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(79, 70, 229, 0.22);
}
.profile__avatar-wrap {
  flex-shrink: 0;
  position: relative;
}
.profile__avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  background: #fff;
  flex-shrink: 0;
  display: block;
}
.profile__avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.94);
}
.profile__avatar-logo {
  width: 72rpx;
  height: 72rpx;
}
.profile__name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.profile__sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

/* ---------------- 微信账号信息 ---------------- */
.wx-card {
  background: #fff;
  border-radius: 24rpx;
  margin-top: 24rpx;
  padding: 26rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.wx-card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.wx-card__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #07c160;
  flex-shrink: 0;
}
.wx-card__dot--off {
  background: #cbd5e1;
}
.wx-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
}
.wx-card__badge {
  margin-left: auto;
  font-size: 20rpx;
  color: #047857;
  background: var(--success-soft);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.wx-card__badge--mock {
  color: #b45309;
  background: var(--warning-soft);
}
.wx-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line-soft);
}
.wx-row:last-of-type {
  border-bottom: none;
}
.wx-row__label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--t3);
}
.wx-row__value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--t1);
  text-align: right;
}
.wx-row__value--mono {
  font-family: Consolas, Menlo, monospace;
  font-size: 22rpx;
  color: var(--primary);
}
.wx-card__tip {
  font-size: 20rpx;
  color: var(--t3);
  margin-top: 8rpx;
}
.wx-card--empty .wx-card__tip {
  line-height: 1.65;
}

/* 概览 */
.mini-stats {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.mini-stat {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.mini-stat__value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}
.mini-stat__label {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

/* 菜单 */
.menu {
  background: #fff;
  border-radius: 24rpx;
  margin-top: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.menu__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 26rpx;
  border-bottom: 2rpx solid var(--line-soft);
}
.menu__item:last-child {
  border-bottom: none;
}
.menu__item:active {
  background: #f8fafc;
}
.menu__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  background: #f1f5f9;
}
.menu__icon--primary {
  background: var(--primary-soft);
}
.menu__icon--warning {
  background: var(--warning-soft);
}
.menu__icon--muted {
  background: #f1f5f9;
}
.menu__title {
  font-size: 28rpx;
  color: var(--t1);
  font-weight: 500;
}
.menu__desc {
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 4rpx;
}
.menu__extra {
  font-size: 22rpx;
  color: var(--t3);
}
.menu__arrow {
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
}
