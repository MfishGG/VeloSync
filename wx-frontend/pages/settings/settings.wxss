.head {
  padding: 8rpx 8rpx 24rpx;
}
.head__title {
  font-size: 38rpx;
  font-weight: 700;
}
.head__sub {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.card + .card {
  margin-top: 24rpx;
}

.urlbox {
  margin-top: 16rpx;
  background: #f8fafc;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--t1);
  font-family: "SF Mono", Menlo, Consolas, monospace;
  word-break: break-all;
}

.linkrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line-soft);
}
.linkrow:last-child {
  border-bottom: none;
}
.linkrow:active {
  background: #fbfcfe;
}
.linkrow__copy {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
}

.menu__arrow {
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
}
