<view class="page page--tabbed">
  <!-- 身份栏：整条可点，展开账号信息 -->
  <view class="ident" bindtap="toggleId">
    <view class="ident__avatar-wrap">
      <image
        wx:if="{{avatarUrl}}"
        class="ident__avatar"
        src="{{avatarUrl}}"
        mode="aspectFill"
        binderror="onAvatarError"
      />
      <view wx:else class="ident__avatar ident__avatar--fallback">
        <image class="ident__avatar-logo" src="/assets/brand/logo-96.png" mode="aspectFit" />
      </view>
      <view class="ident__dot" wx:if="{{wx.connected}}"></view>
    </view>

    <view class="ident__meta">
      <view class="ident__name ellipsis">{{displayName}}</view>
      <view class="ident__sub ellipsis">
        {{wx.connected ? '微信已连接' : '@' + (user.username || '未登录')}}
      </view>
    </view>

    <text class="ident__arrow {{showId ? 'ident__arrow--up' : ''}}">›</text>
  </view>

  <!-- 演示模式：演示账号是一份**共享**数据。不提示的话，演示对象会把它当成
       自己的账号，加完东西下次进来发现「没了」，或反过来拿它当真实数据处理。 -->
  <view class="alert alert--info demo-tip" wx:if="{{demo}}">
    当前为演示模式：以下为预设的示例数据，所有访客共用，不影响你的真实账号。
  </view>

  <!-- 隐私授权提示：未同意《用户隐私保护指引》时，头像 / 昵称组件会被微信
       直接拦截（errno 104）。必须主动提示 —— 尤其 <input type="nickname"> 在未同意时
       会静默降级为普通输入框，拿不到微信昵称却没有任何报错。 -->
  <view class="alert alert--warning privacy" wx:if="{{privacyNeeded}}">
    <view class="privacy__text">
      使用头像、昵称前，请先阅读并同意{{privacyContractName}}
    </view>
    <view class="privacy__ops">
      <text class="privacy__link" bindtap="onOpenPrivacyContract">查看协议</text>
      <button
        id="privacy-agree-btn"
        class="privacy__agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacy"
      >同意</button>
    </view>
  </view>

  <!-- 资料：头像 / 昵称。
       微信自 2022-10-24 起收紧 getUserProfile，无法再一键拿到真实头像昵称，
       故这里按官方「头像昵称填写能力」由用户主动设置。 -->
  <view class="profile">
    <view class="menu__caption">个人资料</view>

    <!-- 头像 -->
    <button
      class="profile__row profile__row--btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <text class="profile__label">头像</text>
      <view class="profile__value grow">
        <image
          wx:if="{{avatarUrl}}"
          class="profile__avatar"
          src="{{avatarUrl}}"
          mode="aspectFill"
          binderror="onAvatarError"
        />
        <view wx:else class="profile__avatar profile__avatar--fallback">
          <image class="profile__avatar-logo" src="/assets/brand/logo-96.png" mode="aspectFit" />
        </view>
      </view>
      <text class="profile__hint">{{savingAvatar ? '保存中…' : '更换'}}</text>
      <text class="profile__arrow">›</text>
    </button>

    <!-- 昵称 -->
    <view class="profile__row">
      <text class="profile__label">昵称</text>
      <input
        class="profile__input grow"
        type="nickname"
        value="{{nicknameDraft}}"
        placeholder="点击填写昵称"
        placeholder-class="profile__ph"
        maxlength="50"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        bindfocus="onNicknameFocus"
      />
      <text class="profile__hint" wx:if="{{savingNickname}}">保存中…</text>
    </view>

    <view class="profile__tip">头像与昵称由你自行设置，不会自动读取微信资料</view>
  </view>

  <!-- 账号信息：默认收起 -->
  <view class="ids" wx:if="{{wx.connected && showId}}">
    <view class="ids__row" bindtap="copyId" data-id="{{wx.openid}}">
      <text class="ids__label">OpenID</text>
      <text class="ids__value ellipsis">{{wx.openid || '—'}}</text>
      <text class="ids__copy">复制</text>
    </view>
    <view class="ids__row" wx:if="{{wx.unionid}}" bindtap="copyId" data-id="{{wx.unionid}}">
      <text class="ids__label">UnionID</text>
      <text class="ids__value ellipsis">{{wx.unionid}}</text>
      <text class="ids__copy">复制</text>
    </view>
    <view class="ids__row" wx:if="{{wx.boundAt}}" bindtap="copyId" data-id="{{wx.boundAt}}">
      <text class="ids__label">绑定时间</text>
      <text class="ids__value">{{wx.boundAt}}</text>
    </view>
    <view class="ids__tip">点击任意一行可复制</view>
  </view>

  <!-- 概览 -->
  <view class="mini-stats">
    <view class="mini-stat" bindtap="goAccounts">
      <view class="mini-stat__value">{{accountCount}}</view>
      <view class="mini-stat__label">已绑账号</view>
    </view>
    <view class="mini-stat">
      <view class="mini-stat__value">{{platformCount}}</view>
      <view class="mini-stat__label">支持平台</view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu">
    <view class="menu__caption">功能</view>

    <view class="menu__item" bindtap="goAccounts">
      <view class="menu__bar menu__bar--primary"></view>
      <view class="menu__title grow">账号管理</view>
      <view class="menu__extra">{{accountCount}} 个</view>
      <view class="menu__arrow">›</view>
    </view>

    <view class="menu__item" bindtap="goLogs">
      <view class="menu__bar menu__bar--warning"></view>
      <view class="menu__title grow">同步日志</view>
      <view class="menu__arrow">›</view>
    </view>

    <view class="menu__item" bindtap="goSettings">
      <view class="menu__bar menu__bar--muted"></view>
      <view class="menu__title grow">设置</view>
      <view class="menu__arrow">›</view>
    </view>
  </view>

  <view class="btn btn--ghost btn--block" bindtap="onLogout" style="margin-top:28rpx">
    退出登录
  </view>

  <!-- 注销：不可逆，入口刻意做得低调（纯文字、无按钮样式），但不隐藏 -->
  <view class="danger-link" bindtap="onDeleteAccount">注销账号</view>

  <view class="t-xs t3" style="text-align:center;margin-top:24rpx">
    VeloSync 速同 · v{{version}}
  </view>

  <view class="safe-bottom"></view>
</view>
