# 环境变量：绝不能打进镜像（含 AppSecret / 数据库密码）
.env
*.env
!.env.example

# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 注意：不要排除 *.sh —— docker-entrypoint.sh 是容器入口，必须进镜像

# 本地数据库与静态产物（容器内重新生成）
db.sqlite3
*.sqlite3
staticfiles/

# 版本控制与编辑器
.git/
.gitignore
.idea/
.vscode/

# 测试与文档（文档在仓库查看即可，无需进运行镜像）
*.md
